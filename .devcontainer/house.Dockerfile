# BeSpunky house — the image this devcontainer builds (devcontainer.json → "build").
#
# Generated by @bespunky/nx-tools:devcontainer — regenerated on every house upgrade. Edit the template in the
# toolkit, not this copy. Your OS packages go in os-packages.txt beside it; anything else of your own goes in
# post-create.local.sh.
#
# WHY A DOCKERFILE: Docker caches every layer, so a rebuild reuses each one whose inputs have not changed. The OS
# packages are one layer here, rebuilt only when a package list changes (or on "Rebuild Without Cache" — which is
# also how to pick up their security updates). Devcontainer features are applied on top of this image.
#
# Claude Code is deliberately NOT installed here: its auto-updater updates it inside the running container, so a
# cached layer would hand back the build-day version on every rebuild. It lives in ~/.local, a persisted volume.
FROM mcr.microsoft.com/devcontainers/typescript-node:22

# `os-packages.tx[t]`: a pattern, so a deleted list cannot fail the build (the installer skips a list that is not there).
COPY house.packages.sh os-packages.tx[t] /tmp/bespunky-os-packages/
RUN sh /tmp/bespunky-os-packages/house.packages.sh /tmp/bespunky-os-packages/os-packages.txt \
    && rm -rf /tmp/bespunky-os-packages /var/lib/apt/lists/*

# The project's package manager, as package.json declared it at the last upgrade: images differ in which they ship.
# Its own layer, so a package list changing does not reinstall it. `||`: a version that cannot be installed must not
# stop the container being built. Post-create runs the same script with what package.json says then, and reports it.
# npm's cache goes with the temp directory, or root's copy of it stays in the layer.
COPY house.package-manager.sh /tmp/bespunky-package-manager/
RUN npm_config_cache=/tmp/bespunky-package-manager/.npm sh /tmp/bespunky-package-manager/house.package-manager.sh 'yarn' \
    || echo "[package-manager] not installed in the image; post-create tries again"; \
    rm -rf /tmp/bespunky-package-manager
