// claude-toolkit devcontainer — a plugin-marketplace repo (markdown skills + Node tool scripts),
// NOT an Nx/Angular app. Trimmed from the BeSpunky house devcontainer generator:
// dropped everything app/server-shaped (Angular+Nx extensions, worktree-domains :80 proxy,
// shared-browser noVNC stack, Firebase, dev-server port forwarding, chokidar polling) and
// kept only what a toolkit author needs: Claude CLI, gh, and the plugins dogfooded LIVE
// from THIS working tree (see .devcontainer/post-create.sh).
{
  "name": "claude-toolkit",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  "features": {
    "ghcr.io/devcontainers/features/github-cli": {},
    // A LOCAL feature — a `./`-prefixed id is a path resolved from this file's own folder, not a registry
    // reference, so nothing is published, versioned separately, or downloaded. It installs nothing: its
    // whole content is a `postCreateCommand` that runs `.devcontainer/post-create.bespunky.sh` IF that file
    // exists.
    //
    // Here it is a deliberate NO-OP — this repo's `postCreateCommand` below already runs the house script
    // under its usual name, so the beside-path does not exist and the guard is false. It is carried anyway
    // because that is the point of the mechanism: the day this file grows a `postCreateCommand` of its own,
    // the generator parks the house script at the beside-path and this feature is what still runs it.
    // Feature lifecycle commands are ADDITIVE — they run before the project's own, never replacing it.
    "./features/bespunky-house-setup": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "DavidAnson.vscode-markdownlint",
        "EditorConfig.EditorConfig",
        "eamodio.gitlens",
        "GitHub.vscode-github-actions",
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Tobermory.es6-string-html",
        "formulahendry.auto-rename-tag",
        "nrwl.angular-console"
      ],
      "settings": {
        "claude-code.dangerouslySkipPermissions": true,
        "editor.formatOnSave": false,
        // Skills are authored as SKILL.md / *.mdc; treat .mdc as markdown so linting/preview work.
        "files.associations": {
          "*.mdc": "markdown"
        },
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.validate": [
          "javascript",
          "typescript",
          "html"
        ],
        "typescript.preferences.importModuleSpecifier": "relative",
        "typescript.updateImportsOnFileMove.enabled": "always"
      }
    }
  },

  // All setup lives in .devcontainer/post-create.sh so this stays a one-liner.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Runs ON THE HOST before the container is created: points .devcontainer/.host/pulse at this
  // machine's audio-socket folder (WSLg, native PulseAudio, PipeWire) — or an empty dir — so the
  // audio mount below is valid on every host. Same shape the devcontainer generator writes for --voice.
  "initializeCommand": {
    "bespunky-host-probe": "sh .devcontainer/host-probe.sh"
  },
  "remoteUser": "node",

  "remoteEnv": {
    "CLAUDE_CODE_BYPASS_ALL_PERMISSIONS": "1",
    // The host's audio socket, bridged in by the mount below at ONE fixed endpoint on every host —
    // foundation for the voice plugin (whose resolver also finds WSLg's `PulseServer` name there).
    "PULSE_SERVER": "unix:/run/bespunky/host/pulse/native",
    // Host fact passed through (empty off WSL): only picks the voice plugin's default mic gain.
    "BESPUNKY_HOST_WSL_DISTRO": "${localEnv:WSL_DISTRO_NAME}",
    "PATH": "/home/node/.local/bin:${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}",
    "CHOKIDAR_USEPOLLING": "true",
    "CHOKIDAR_INTERVAL": "1000"
  },

  // Persist Claude's auth/config/plugin state across container rebuilds. `.claude/data` is
  // gitignored (see .gitignore); a committed .gitkeep guarantees the dir exists on fresh
  // clones so Docker binds a real (node-owned) directory instead of creating a root-owned one.
  "mounts": [
    "source=${localWorkspaceFolder}/.claude/data,target=/home/node/.claude,type=bind,consistency=cached",
    // Host audio: the fixed source the host probe (initializeCommand) aimed at this machine's socket
    // folder, or an empty dir — so the mount never fails, on WSL or plain Linux alike.
    "source=${localWorkspaceFolder}/.devcontainer/.host/pulse,target=/run/bespunky/host/pulse,type=bind",
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-nx-cache,target=${containerWorkspaceFolder}/.nx/cache,type=volume",
    "source=${localWorkspaceFolderBasename}-nx-workspace-data,target=${containerWorkspaceFolder}/.nx/workspace-data,type=volume",
    "source=${localWorkspaceFolderBasename}-config,target=/home/node/.config,type=volume"
  ],
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  }
}
