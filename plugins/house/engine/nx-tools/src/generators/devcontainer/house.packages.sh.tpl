#!/bin/sh
# BeSpunky house — the OS packages this container needs, and the ONE installer for them.
#
# Generated by @bespunky/nx-tools:devcontainer — regenerated on every house upgrade. Edit the template in the
# toolkit, not this copy. YOUR packages go in .devcontainer/os-packages.txt (one per line, `#` comments), never here.
#
# TWO CALLERS, ONE RULE — install only what is MISSING:
#   - the IMAGE BUILD (.devcontainer/house.Dockerfile) runs it as root: everything is missing, so it installs the
#     lot — as one Docker layer, cached until this file or os-packages.txt changes. That is the whole point: a
#     rebuild reinstalls nothing that has not changed.
#   - post-create runs it on every container create: in a container built from the house Dockerfile every package
#     is already there and it does nothing; in one built from an image of the project's own (an adopted
#     devcontainer), it installs them, as the house always did.
#
# Exits non-zero when an install fails after its retries — the image build fails loudly instead of producing a
# container that is quietly missing tools; post-create reports it and carries on.
#
# POSIX sh, not bash: it runs in the image build before any layer has added bash to a minimal base.
set -u

# The house's packages, composed from this project's layers and grouped BY CAPABILITY — so a reader can tell why each
# one is here, and it leaves with the layer that needs it. (No layer list or version is stamped in this file on
# purpose: the image build's cached layer is keyed on its content, so only a real package change may move it.)
HOUSE_PACKAGES='
{{HOUSE_PACKAGES}}
'

{{#ARCHIVES}}
# Tools installed from their publisher's VERSIONED ARCHIVE — kept for every release, unlike an apt repository's rolling
# index — one line per architecture: `<id> <version> <arch> <sha256> <url> <bin>`. Each is extracted into
# /opt/bespunky/<id>/<version> (`current` points at it), its <bin> executables linked into /usr/local/bin — first on
# PATH, ahead of an apt copy in /usr/bin. Validated by the composer; the download is checked against its sha256.
HOUSE_ARCHIVES='
{{HOUSE_ARCHIVES}}
'

{{/ARCHIVES}}
{{#DEB_ARCHIVES}}
# Tools published as Debian packages, unpacked WITHOUT dpkg into /opt/bespunky/<id>/<version> (`current` points at it):
# no maintainer scripts, nothing registered, nothing that can collide with a package this image already holds. The
# closure is built for one Debian release, so its lines are keyed by codename and arch:
#   tool    <id> <bin> <library dirs, comma-separated, `*` allowed> [<prune paths, comma-separated>]
#   closure <id> <codename> <version> <what Debian must supply: an apt relation string, for `apt-get satisfy`>
#   deb     <id> <codename> <arch> <sha256> <url>
# Its binaries have no RUNPATH, so each gets a generated WRAPPER in /usr/local/bin that sets LD_LIBRARY_PATH: a plain
# link would load the system's library of the same name. Validated by the composer; every download is checked against
# its sha256 before anything on this machine changes.
HOUSE_DEB_ARCHIVES='
{{HOUSE_DEB_ARCHIVES}}
'

{{/DEB_ARCHIVES}}
# Every list: the house's, then each file given (the project's own). Comments and blanks dropped, de-duplicated in
# order; CR stripped, so a list saved with Windows line endings still reads. A token that is not a Debian package NAME
# is refused here, before it can reach a root apt-get command line.
wanted() {
  { printf '%s\n' "$HOUSE_PACKAGES"; for list in "$@"; do [ -f "$list" ] && cat "$list"; done; } |
    tr -d '\r' | sed 's/#.*//' | tr -s ' \t' '\n\n' | sed '/^$/d' | awk '!seen[$0]++' |
    while read -r name; do
      case "$name" in
        *[!a-z0-9.+-]* | [!a-z0-9]*) echo "[os-packages] ignoring '$name' — not a Debian package name" >&2 ;;
        *) echo "$name" ;;
      esac
    done
}

missing=""
for name in $(wanted "$@"); do
  dpkg-query -W -f='${Status}' "$name" 2>/dev/null | grep -q ' installed$' || missing="$missing $name"
done
{{#ARCHIVE_TOOLS}}
# The archive tools to install (found below).
{{/ARCHIVE_TOOLS}}
pending=""
{{#ARCHIVE_TOOLS}}

# Where the archives go. HOUSE_PACKAGES_ROOT re-roots both directories — for the toolkit's own tests, never set in a build.
archive_home="${HOUSE_PACKAGES_ROOT:-}/opt/bespunky"
archive_links="${HOUSE_PACKAGES_ROOT:-}/usr/local/bin"

# This machine's architecture, as Debian names it — the one the archive lines are keyed by.
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch="$(uname -m)" ;;
esac
{{/ARCHIVE_TOOLS}}
{{#ARCHIVES}}

# The archive lines for this architecture (comments and blanks dropped).
archives() { printf '%s\n' "$HOUSE_ARCHIVES" | sed 's/#.*//' | awk -v arch="$arch" 'NF == 6 && $3 == arch'; }

# Pending: each archive tool not installed AT its pinned version (`current` names it — a pin moved in the toolkit
# installs the new release), and, as `!<id>`, each with no archive for this architecture (reported, and the exit fails).
for id in $(printf '%s\n' "$HOUSE_ARCHIVES" | sed 's/#.*//' | awk 'NF == 6 { print $1 }' | awk '!seen[$0]++'); do
  version="$(archives | awk -v id="$id" '$1 == id { print $2 }')"
  if [ -z "$version" ]; then
    echo "[os-packages] '$id' has no archive for this architecture ($arch) — it cannot be installed here" >&2
    pending="$pending !$id"
  elif [ "$(readlink "$archive_home/$id/current" 2>/dev/null)" != "$version" ] || [ ! -d "$archive_home/$id/$version" ]; then
    pending="$pending $id"
  fi
done
{{/ARCHIVES}}
{{#DEB_ARCHIVES}}

# This image's Debian release, as a closure is keyed by it. A closure is linked against ONE release's libraries, and the
# base image tags move across releases: another release is refused, never run on libraries it was not built for.
codename="$(sed -n 's/^VERSION_CODENAME=//p' "${HOUSE_PACKAGES_ROOT:-}/etc/os-release" 2>/dev/null | tr -d '"')"

# The lines of one kind (`tool`, `closure`, `deb`) for one tool (comments and blanks dropped).
deb_archive() { printf '%s\n' "$HOUSE_DEB_ARCHIVES" | sed 's/#.*//' | awk -v kind="$1" -v id="$2" '$1 == kind && $2 == id'; }

# Pending, as `deb:<id>`: each closure not installed AT this release's version — and, as `!<id>`, each with nothing for
# this Debian release or this architecture (reported, and the exit fails).
for id in $(printf '%s\n' "$HOUSE_DEB_ARCHIVES" | sed 's/#.*//' | awk '$1 == "tool" { print $2 }'); do
  version="$(deb_archive closure "$id" | awk -v codename="$codename" '$3 == codename { print $4 }')"
  if [ -z "$version" ]; then
    echo "[os-packages] '$id' has no closure for this Debian release ('${codename:-unknown}'; it has: $(deb_archive closure "$id" | awk '{ print $3 }' | tr '\n' ' ')) — it cannot be installed here. A newer house toolkit may cover this release: upgrade it. If this devcontainer names its own image, use a tag on one of those releases." >&2
    pending="$pending !$id"
  elif [ -z "$(deb_archive deb "$id" | awk -v codename="$codename" -v arch="$arch" '$3 == codename && $4 == arch')" ]; then
    echo "[os-packages] '$id' has no closure for this architecture ($arch) on $codename — it cannot be installed here" >&2
    pending="$pending !$id"
  elif [ "$(readlink "$archive_home/$id/current" 2>/dev/null)" != "$version" ] || [ ! -d "$archive_home/$id/$version" ]; then
    pending="$pending deb:$id"
  fi
done
{{/DEB_ARCHIVES}}
if [ -z "$missing$pending" ]; then
  echo "[os-packages] all present — nothing to install"
  exit 0
fi

as_root=""
[ "$(id -u)" = 0 ] || as_root="sudo"

# The apt packages: ONE transaction, retried (apt mirrors are occasionally flaky over Docker DNS).
install_packages() {
  echo "[os-packages] installing:$missing"
  for attempt in 1 2 3; do
    # $missing is deliberately UNQUOTED: one argument per package. Safe — every member passed the name check above.
    # shellcheck disable=SC2086
    if $as_root apt-get update && $as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y $missing; then
      echo "[os-packages] installed"
      return 0
    fi
    if [ "$attempt" -lt 3 ]; then
      echo "[os-packages] attempt $attempt/3 failed (apt mirrors are occasionally flaky over Docker DNS); retrying in $((attempt * 10))s..."
      sleep $((attempt * 10))
    fi
  done
  # One unknown or broken name fails the whole transaction above — and with it every package that was fine. So install
  # what CAN be installed, one by one, and name exactly what could not: a typo in os-packages.txt must not take the
  # house's packages (or the rest of the project's) down with it.
  echo "[os-packages] the batch failed 3 times — installing one by one to find the package at fault"
  failed=""
  for name in $missing; do
    $as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y "$name" > /dev/null 2>&1 || failed="$failed $name"
  done
  echo "[os-packages] FAILED:$failed" >&2
  return 1
}
{{#ARCHIVE_TOOLS}}

# Download one file and hold it to its pinned sha256; says what failed.
fetch_checked() {   # fetch_checked <sha256> <url> <file>
  if ! curl -fsSL --retry 3 --retry-delay 5 -o "$3" "$2"; then
    echo "[os-packages] FAILED to download $2" >&2; return 1
  fi
  if ! echo "$1  $3" | sha256sum -c - > /dev/null 2>&1; then
    echo "[os-packages] FAILED: $2 does not match its pinned sha256 — refusing to install it" >&2; return 1
  fi
}

# Everything in a tool's home but this release and the link to it.
drop_other_releases() {   # drop_other_releases <home> <version>
  for old in "$1"/*; do
    [ "${old##*/}" = "$2" ] || [ "${old##*/}" = current ] || $as_root rm -rf "$old"
  done
}
{{/ARCHIVE_TOOLS}}
{{#ARCHIVES}}

# One archive tool at its pinned version: download, check the sha256, extract BESIDE any other release, switch
# `current`, link its executables, then drop the release it replaced and any link left dangling.
install_archive() {
  set -- $(archives | awk -v id="$1" '$1 == id')
  id="$1" version="$2" sha256="$4" url="$5" bin="$6"
  home="$archive_home/$id"
  echo "[os-packages] installing $id $version ($arch) from $url"
  download="$(mktemp -d)" || return 1
  fetch_checked "$sha256" "$url" "$download/archive.tar.gz" || { rm -rf "$download"; return 1; }
  $as_root mkdir -p "$home" "$archive_links" &&
    $as_root rm -rf "$home/.partial" && $as_root mkdir "$home/.partial" &&
{{#TARBALLS_ONLY}}
    $as_root tar -xzf "$download/archive.tar.gz" -C "$home/.partial" --no-same-owner &&
{{/TARBALLS_ONLY}}
{{#BINARY_ARCHIVES}}
    case "$url" in
      *.tar.gz) $as_root tar -xzf "$download/archive.tar.gz" -C "$home/.partial" --no-same-owner ;;
      *) $as_root mkdir -p "$home/.partial/$bin" && $as_root cp "$download/archive.tar.gz" "$home/.partial/$bin/$id" && $as_root chmod 0755 "$home/.partial/$bin/$id" ;;
    esac &&
{{/BINARY_ARCHIVES}}
    $as_root rm -rf "$home/$version" && $as_root mv "$home/.partial" "$home/$version" &&
    $as_root ln -sfn "$version" "$home/current" || { rm -rf "$download"; echo "[os-packages] FAILED to unpack $id" >&2; return 1; }
  rm -rf "$download"
  for tool in "$home/$version/$bin"/*; do
    [ -f "$tool" ] && [ -x "$tool" ] || continue
    link="$archive_links/${tool##*/}"
    # Never over somebody else's file: only a free name, or a link this installer made, is (re)pointed.
    if [ -e "$link" ] && ! { [ -L "$link" ] && case "$(readlink "$link")" in "$home"/*) true ;; *) false ;; esac; }; then
      echo "[os-packages] $link exists and is not $id's — left alone; $id's ${tool##*/} is at $home/current/$bin" >&2
      continue
    fi
    $as_root ln -sfn "$home/current/$bin/${tool##*/}" "$link" || return 1
  done
  for link in "$archive_links"/*; do
    [ -L "$link" ] && [ ! -e "$link" ] && case "$(readlink "$link")" in "$home"/*) $as_root rm -f "$link" ;; esac
  done
  drop_other_releases "$home" "$version"
  echo "[os-packages] $id $version installed"
}
{{/ARCHIVES}}
{{#DEB_ARCHIVES}}

# What a closure needs from Debian, by name, in one retried transaction. --no-install-recommends is the point: Recommends
# would pull in services (systemd, a mail server) the closure never runs.
satisfy_system_depends() {
  for attempt in 1 2 3; do
    if $as_root apt-get update && $as_root env DEBIAN_FRONTEND=noninteractive apt-get satisfy -y --no-install-recommends "$1"; then
      return 0
    fi
    if [ "$attempt" -lt 3 ]; then
      echo "[os-packages] attempt $attempt/3 failed (apt mirrors are occasionally flaky over Docker DNS); retrying in $((attempt * 10))s..."
      sleep $((attempt * 10))
    fi
  done
  return 1
}

# Is this file a wrapper this installer made for this tool? (Its second line says so.)
is_wrapper_of() { [ -f "$2" ] && [ ! -L "$2" ] && [ "$(sed -n 2p "$2" 2>/dev/null)" = "# bespunky-house wrapper for $1" ]; }

# One closure at this release's version: download and check EVERY file (a bad one changes nothing on this machine), get
# what Debian must supply, unpack BESIDE any other release, write the wrappers, switch `current` (what says it is installed,
# so a failure before it is retried on the next run), then drop the release it replaced and any wrapper it no longer has.
install_deb_archive() {
  id="$1"
  home="$archive_home/$id"
  version="$(deb_archive closure "$id" | awk -v codename="$codename" '$3 == codename { print $4 }')"
  system_depends="$(deb_archive closure "$id" | awk -v codename="$codename" '$3 == codename { $1 = $2 = $3 = $4 = ""; sub(/^ +/, ""); print }')"
  bin="$(deb_archive tool "$id" | awk '{ print $3 }')"
  library_paths="$(deb_archive tool "$id" | awk '{ print $4 }')"
  prune="$(deb_archive tool "$id" | awk '{ print $5 }')"
  echo "[os-packages] installing $id $version ($codename, $arch)"
  download="$(mktemp -d)" || return 1
  count=0
  deb_archive deb "$id" | awk -v codename="$codename" -v arch="$arch" '$3 == codename && $4 == arch { print $5, $6 }' > "$download/list"
  while read -r sha256 url; do
    count=$((count + 1))
    fetch_checked "$sha256" "$url" "$download/$count.deb" || { rm -rf "$download"; return 1; }
  done < "$download/list"
  if [ -n "$system_depends" ] && ! satisfy_system_depends "$system_depends"; then
    rm -rf "$download"; echo "[os-packages] FAILED: Debian could not supply what $id needs: $system_depends" >&2; return 1
  fi
  if ! { $as_root mkdir -p "$home" "$archive_links" && $as_root rm -rf "$home/.partial" && $as_root mkdir "$home/.partial"; }; then
    rm -rf "$download"; echo "[os-packages] FAILED to unpack $id" >&2; return 1
  fi
  for deb in "$download"/*.deb; do
    if ! $as_root dpkg-deb -x "$deb" "$home/.partial"; then
      rm -rf "$download"; echo "[os-packages] FAILED to unpack $id" >&2; return 1
    fi
  done
  rm -rf "$download"
  for path in $(printf '%s' "$prune" | tr ',' ' '); do
    $as_root rm -rf "$home/.partial/$path" || return 1
  done
  # The library directories as `current` will name them. `read`, not a word split: a `*` must expand inside the tree only.
  library_path="$(printf '%s\n' "$library_paths" | tr ',' '\n' | while read -r pattern; do
    for dir in "$home/.partial"/$pattern; do
      [ -d "$dir" ] && printf '%s:' "$home/current/${dir#"$home/.partial/"}"
    done
  done)"
  # No trailing `:`: an empty LD_LIBRARY_PATH entry means the current directory.
  library_path="${library_path%:}"
  if [ -z "$library_path" ] || [ ! -d "$home/.partial/$bin" ]; then
    echo "[os-packages] FAILED: $id's closure has no '$bin' or no '$library_paths' — its binaries could not run" >&2; return 1
  fi
  $as_root rm -rf "$home/$version" && $as_root mv "$home/.partial" "$home/$version" || { echo "[os-packages] FAILED to unpack $id" >&2; return 1; }
  for tool in "$home/$version/$bin"/*; do
    [ -f "$tool" ] && [ -x "$tool" ] || continue
    link="$archive_links/${tool##*/}"
    # Never over somebody else's file: only a free name, or a wrapper this installer made, is (re)written.
    if { [ -e "$link" ] || [ -L "$link" ]; } && ! is_wrapper_of "$id" "$link"; then
      echo "[os-packages] $link exists and is not $id's — left alone; $id's ${tool##*/} is at $home/current/$bin" >&2
      continue
    fi
    printf '#!/bin/sh\n# bespunky-house wrapper for %s\nLD_LIBRARY_PATH="%s${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"\nexport LD_LIBRARY_PATH\nexec "%s" "$@"\n' \
      "$id" "$library_path" "$home/current/$bin/${tool##*/}" | $as_root tee "$link" > /dev/null &&
      $as_root chmod 755 "$link" || return 1
  done
  $as_root ln -sfn "$version" "$home/current" || { echo "[os-packages] FAILED to switch $id to $version" >&2; return 1; }
  for link in "$archive_links"/*; do
    is_wrapper_of "$id" "$link" && [ ! -x "$home/$version/$bin/${link##*/}" ] && $as_root rm -f "$link"
  done
  drop_other_releases "$home" "$version"
  echo "[os-packages] $id $version installed"
}
{{/DEB_ARCHIVES}}

status=0
if [ -n "$missing" ]; then
  install_packages || status=1
fi
{{#ARCHIVE_TOOLS}}
for id in $pending; do
  case "$id" in
    !*) status=1 ;;
{{#DEB_ARCHIVES}}
    deb:*) install_deb_archive "${id#deb:}" || status=1 ;;
{{/DEB_ARCHIVES}}
{{#ARCHIVES}}
    *) install_archive "$id" || status=1 ;;
{{/ARCHIVES}}
  esac
done
{{/ARCHIVE_TOOLS}}
# Non-zero when anything failed: the image build fails loudly; post-create reports it and carries on.
exit $status
