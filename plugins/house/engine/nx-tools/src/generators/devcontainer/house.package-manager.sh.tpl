#!/bin/sh
# BeSpunky house — make the project's package manager runnable in this container, at the version it asked for.
#
# Generated by @bespunky/nx-tools:devcontainer — regenerated on every house upgrade. Edit the template in the toolkit,
# not this copy. To change what it installs, change `packageManager` in package.json.
#
# WHY IT EXISTS: an image's package managers are the image's accident. typescript-node:26 ships neither yarn nor
# corepack, :24 ships yarn 1 and no pnpm, and a project on yarn 4 cannot use yarn 1 without a `yarnPath`.
#
# TWO CALLERS, ONE RULE — install only what is not already right:
#   - the IMAGE BUILD (.devcontainer/house.Dockerfile), as root, with what package.json said at the last upgrade: one
#     cached Docker layer, so a rebuild installs nothing unless that changed. package.json is not in the build's context,
#     and putting it there would rebuild the layer on every dependency change.
#   - post-create, on every container create, with what package.json says NOW. That is the check that counts: it covers
#     a project that changed `packageManager` since its last upgrade, and an adopted devcontainer's image of its own.
#
# THE SPEC, the one argument (derived by _utils/package-manager.ts, in TypeScript and as shell, by one rule):
#   <pm>            no version asked for: any present copy is right, the house's pin if there is none
#   <pm>@1.22.22    this exact version
#   <pm>@4          any 4.x is right, the house's pin of that line if there is none (never whatever is newest)
#   yarn@berry      no version declared, but the repo is yarn 2+: any of those, the house's pin if there is none
#
# Exits non-zero when it could not make that true, having said why. Neither caller lets that stop it: the image build
# carries on and leaves it to post-create, whose install then says what it costs.
#
# POSIX sh, like house.packages.sh.
set -u

# The house's versions: the first of a package manager (or of a yarn line) is the one a project asking for none gets.
# npm has none: this script installs with npm, so an npm project with no version is already satisfied, or nothing can help.
HOUSE_PINS='
{{HOUSE_PINS}}
'

spec="${1:-}"
pm="${spec%%@*}"
want=""
case "$spec" in *@*) want="${spec#*@}" ;; esac

case "$pm" in
  yarn | pnpm | npm) ;;
  *) echo "[package-manager] '$spec' is not a package manager this script installs (yarn, pnpm, npm)" >&2; exit 1 ;;
esac
# It reaches an npm command line and comes from a file a human edits.
case "$want" in
  *[!0-9A-Za-z.-]* | -*) echo "[package-manager] '$want' is not a version — nothing installed" >&2; exit 1 ;;
esac

# What this command answers from here. In a project, yarn's answer is the project's own yarn when it has a `yarnPath`.
# A command that cannot answer (corepack's shim with no network) counts as absent. `hash -r`: this shell remembers where it
# found npm, so after `npm@<x>` landed earlier on PATH it would go on asking the old copy.
present() { hash -r; command -v "$pm" > /dev/null 2>&1 && "$pm" --version 2> /dev/null < /dev/null | head -n 1 | tr -d ' \r'; }

is_right() {
  case "$want:$1" in
    *:) return 1 ;;
    :*) return 0 ;;
    berry:1.*) return 1 ;;
    berry:*) return 0 ;;
    "$want:$want" | "$want:$want".*) return 0 ;;
    *) return 1 ;;
  esac
}

found="$(present)"
if is_right "$found"; then
  echo "[package-manager] $pm $found — nothing to install"
  exit 0
fi

# Exact → itself. Anything else → the first pin it allows, or nothing: an npm range here would float.
case "$want" in
  *.*.*) version="$want" ;;
  *)
    version=""
    for pin in $(printf '%s\n' "$HOUSE_PINS" | awk -v pm="$pm" '$1 == pm { print $2 }'); do
      if is_right "$pin"; then version="$pin"; break; fi
    done
    ;;
esac
if [ -z "$version" ]; then
  echo "[package-manager] this container's $pm is ${found:-absent}, the project asks for ${want:-any}, and the house pins no such version." >&2
  echo "[package-manager] Declare an exact one: \"packageManager\": \"$pm@<x.y.z>\" in package.json." >&2
  exit 1
fi

if ! command -v npm > /dev/null 2>&1; then
  echo "[package-manager] cannot install $pm $version: this image has no npm. Add $pm to the image." >&2
  exit 1
fi

# yarn 2+ is not published as `yarn` on npm: that name stops at 1.x.
case "$pm@$version" in
  yarn@1.*) package="yarn@$version" ;;
  yarn@*) package="@yarnpkg/cli-dist@$version" ;;
  *) package="$pm@$version" ;;
esac

# Into npm's global prefix: part of the image (or gone with the container). --force: an image's own copy may hold the
# bin name there, as the node images' yarn does in /usr/local/bin.
# Then, not as root, into ~/.local, which is first on the house's PATH and needs no permission: a non-root user may not
# be able to write the prefix, may not be able to replace a copy the image build installed as root, and an earlier
# fallback there may be what is shadowing the prefix. A version check after each install is what decides, so a copy that
# lands behind another on PATH is never reported as done.
# --ignore-scripts: none of these packages needs one, and with --force a failing one leaves the bin it replaced dangling.
#
# As root, what landed goes to whoever owns the prefix. Otherwise the non-root post-create can neither replace nor retire
# it: npm leaves root-owned `.yarn-*` orphans, then ENOTEMPTY. A prefix root owns needs nothing, and ~/.local covers that.
hand_back() {
  [ "$(id -u)" = 0 ] || return 0
  prefix="$(npm prefix -g)" && owner="$(stat -c %u:%g "$prefix/lib/node_modules")" || return 0
  [ "${owner%%:*}" != 0 ] || return 0
  find "$prefix/lib/node_modules" "$prefix/bin" -user 0 -exec chown -h "$owner" {} + || true
}
install_with() {
  echo "[package-manager] npm install -g $* $package"
  rc=0
  npm install -g --force --ignore-scripts --no-audit --no-fund "$@" "$package" || rc=$?
  hand_back
  [ "$rc" = 0 ] && is_right "$(present)"
}
if install_with; then
  echo "[package-manager] $pm $version installed"
  exit 0
fi
if [ "$(id -u)" != 0 ] && [ -n "${HOME:-}" ] && install_with --prefix "$HOME/.local"; then
  echo "[package-manager] $pm $version installed in ~/.local"
  exit 0
fi
echo "[package-manager] could not make $pm $version the one on PATH (it answers: $(present || true); it is $(command -v "$pm" || echo absent))." >&2
exit 1
