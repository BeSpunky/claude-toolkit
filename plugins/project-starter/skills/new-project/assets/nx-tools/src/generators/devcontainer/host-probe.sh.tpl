#!/bin/sh
# Generated by @bespunky/nx-tools:devcontainer — regenerated on every `scaffold.sh --sync`; do not edit.
#
# HOST PROBE for the voice audio bridge. Runs ON THE HOST, as devcontainer.json's `initializeCommand`, on
# every container open — before the container is created, so before any mount is resolved.
#
# WHAT IT ANSWERS: where is THIS machine's PulseAudio-protocol socket? That is a per-machine fact (WSLg,
# native PulseAudio, PipeWire's pulse shim, or nothing at all), so it is resolved here, at open time, and
# never committed. `voice` in the committed config only says "this project wants audio".
#
# WHY A SYMLINK, NOT A CHOSEN MOUNT SOURCE: devcontainer.json's `${localEnv:…}` is substituted BEFORE
# `initializeCommand` runs, so nothing this script learns can change what the mount names. The mount
# therefore names one FIXED source — `.devcontainer/.host/pulse` — and this script makes that source point
# somewhere real. A bind mount follows a symlinked source, so the container sees the host socket's folder.
#
# WHY IT ALWAYS LEAVES SOMETHING BEHIND: Docker refuses a bind mount whose source is missing, so the
# container would not start at all. With no socket anywhere, `.host/pulse` becomes an EMPTY REAL DIRECTORY
# — the mount succeeds, the container opens, and post-create simply finds no socket and skips voice.
#
# The candidates are found by EXISTENCE, never by asking "is this WSL": a WSL host is just one whose
# WSLg paths happen to exist. Order = most specific first:
#   1. $PULSE_SERVER (unix: form)              — whatever this host already told its own clients
#   2. $XDG_RUNTIME_DIR/pulse/native           — PulseAudio, or PipeWire's pulse shim, on a Linux desktop
#   3. /mnt/wslg/runtime-dir/pulse/native      — WSLg's runtime dir
#   4. /mnt/wslg/PulseServer                   — WSLg's long-standing socket
#
# UNVERIFIED: Docker Desktop's WSL2 backend resolves bind sources inside its own VM, so whether it follows
# a symlink out of the workspace into /mnt/wslg has not been tested.
#
# It must NEVER fail the container start — every exit is 0. POSIX sh, so any host shell can run it.

# Resolve relative to this script, not the caller's cwd (initializeCommand runs from the workspace folder,
# but a human re-running it by hand might not).
here=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || exit 0
host_dir="$here/.host"
link="$host_dir/pulse"

mkdir -p "$host_dir" 2>/dev/null || exit 0

uid=$(id -u 2>/dev/null || echo 0)
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$uid}

# $PULSE_SERVER may also be a tcp: address or a list; only a single unix socket path is usable as a mount.
pulse_env=""
case "${PULSE_SERVER:-}" in
  unix:/*) pulse_env=${PULSE_SERVER#unix:} ;;
  /*) pulse_env=$PULSE_SERVER ;;
esac

socket=""
for candidate in "$pulse_env" "$runtime_dir/pulse/native" /mnt/wslg/runtime-dir/pulse/native /mnt/wslg/PulseServer; do
  [ -n "$candidate" ] || continue
  if [ -S "$candidate" ]; then
    socket=$candidate
    break
  fi
done

# Idempotent: whatever the last open left (a symlink, or the empty fallback dir) is replaced. `rm -rf` on a
# symlink removes the link only, never what it points at; and the fallback dir is ours and always empty.
rm -rf "$link" 2>/dev/null

if [ -n "$socket" ]; then
  source_dir=$(dirname -- "$socket")
  ln -s "$source_dir" "$link" 2>/dev/null || mkdir -p "$link" 2>/dev/null
  echo "[host-probe] audio bridge: $socket"
else
  source_dir=""
  mkdir -p "$link" 2>/dev/null
  echo "[host-probe] audio bridge: no PulseAudio-protocol socket on this host — voice will be skipped"
fi

# Facts, for logs and debugging only — nothing reads this as an input.
{
  echo "# Written by .devcontainer/host-probe.sh on every container open. Machine-local; gitignored."
  echo "BESPUNKY_HOST_PROBED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  echo "BESPUNKY_HOST_PULSE_SOCKET=$socket"
  echo "BESPUNKY_HOST_PULSE_DIR=$source_dir"
  echo "BESPUNKY_HOST_WSL_DISTRO=${WSL_DISTRO_NAME:-}"
} >"$host_dir/host.env" 2>/dev/null

exit 0
